# App
DEBUG=true

# Auth — generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret-key

# Database (docker-compose overrides host to service name "postgres")
DATABASE_URL=postgresql+asyncpg://leetcode:password@localhost:5432/leetcode_mentor

# Redis (docker-compose overrides host to service name "redis")
REDIS_URL=redis://localhost:6379

# AI — get free key at https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]
